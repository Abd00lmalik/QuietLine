{
  "name": "quietline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Private credit, settled on Flare.",
  "workspaces": [
    "packages/*",
    "contracts",
    "relayer",
    "frontend"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @quietline/protocol build && pnpm --filter @quietline/frontend build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @quietline/frontend dev",
    "dev:relayer": "pnpm --filter @quietline/relayer dev",
    "coston2:prepare": "node scripts/coston2/prepare.mjs",
    "coston2:preflight": "node scripts/coston2/preflight.mjs",
    "coston2:configure-indexer": "node scripts/coston2/configure-indexer.mjs",
    "coston2:rotate-relayer-key": "node scripts/coston2/rotate-relayer-key.mjs",
    "coston2:configure-hosting": "node scripts/coston2/configure-hosting.mjs",
    "coston2:register-extension": "node scripts/coston2/register-extension.mjs",
    "coston2:register-machine": "node scripts/coston2/register-machine.mjs",
    "coston2:pause-stale-machine": "node scripts/coston2/pause-stale-machine.mjs",
    "coston2:retire-stale-machines": "node scripts/coston2/retire-stale-machines.mjs",
    "hosting:gcp:provision": "powershell -ExecutionPolicy Bypass -File scripts/hosting/gcp-provision.ps1",
    "hosting:gcp:deploy": "powershell -ExecutionPolicy Bypass -File scripts/hosting/gcp-deploy.ps1",
    "hosting:gcp:cutover": "powershell -ExecutionPolicy Bypass -File scripts/hosting/gcp-cutover.ps1",
    "hosting:ssh:provision": "powershell -ExecutionPolicy Bypass -File scripts/hosting/ssh-provision.ps1",
    "hosting:ssh:deploy": "powershell -ExecutionPolicy Bypass -File scripts/hosting/ssh-deploy.ps1",
    "hosting:ssh:cutover": "powershell -ExecutionPolicy Bypass -File scripts/hosting/ssh-cutover.ps1",
    "coston2:seed-lender": "pnpm --filter @quietline/frontend coston2:seed-lender",
    "coston2:smoke-borrow": "pnpm --filter @quietline/frontend coston2:smoke-borrow",
    "fcc:sync-tooling": "node scripts/coston2/sync-fcc-tooling.mjs",
    "fcc:render-config": "node --env-file=fcc/.env.coston2 fcc/render-proxy-config.mjs",
    "fcc:validate-compose": "docker compose --env-file fcc/.env.coston2 -f fcc/docker-compose.coston2.yaml config --quiet",
    "fcc:tunnel:up": "docker compose --env-file .env --env-file fcc/.env.coston2 -f fcc/docker-compose.coston2.yaml -f fcc/docker-compose.ngrok.yaml up -d relayer public-gateway ngrok-fcc",
    "fcc:tunnel:logs": "docker compose --env-file .env --env-file fcc/.env.coston2 -f fcc/docker-compose.coston2.yaml -f fcc/docker-compose.ngrok.yaml logs --tail=100 ngrok-fcc",
    "image:all": "node scripts/coston2/build-images.mjs",
    "image:extension": "node scripts/coston2/build-images.mjs extension",
    "image:relayer": "node scripts/coston2/build-images.mjs relayer",
    "test:extension": "cd extension && go test ./...",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:extension"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "devDependencies": {
    "ethers": "6.15.0"
  }
}
