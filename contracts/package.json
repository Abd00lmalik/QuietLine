{
  "name": "@quietline/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "deploy:coston2": "hardhat run scripts/deploy-coston2.ts --network coston2",
    "set-extension:coston2": "hardhat run scripts/set-extension-id.ts --network coston2",
    "configure:coston2": "hardhat run scripts/configure-extension.ts --network coston2",
    "verify:coston2": "hardhat run scripts/verify-deployment.ts --network coston2",
    "fund-backstop:coston2": "hardhat run scripts/fund-backstop-coston2.ts --network coston2",
    "seed:local": "hardhat run scripts/seed-local.ts --network localhost"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.1.0",
    "chai": "^4.5.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "dotenv": "^17.2.1"
  }
}
